# Copia este archivo como "server/.env" y pega tu URL real de Postgres.
#
# Neon (https://neon.tech) — botón "Connect" → "Connection string".
#   Suele verse así:
#   DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Supabase (https://supabase.com) — Project Settings → Database → Connection string (URI).
#
# Postgres local:
#   DATABASE_URL=postgresql://postgres:tuclave@localhost:5432/glow

DATABASE_URL=

# Puerto del servidor (opcional, por defecto 3001).
PORT=3001

# Registro opcional de clientes con Google (Google Cloud Console → APIs y
# servicios → Credenciales → ID de cliente de OAuth, tipo "Aplicación web").
# Déjalo vacío para ocultar el registro.
GOOGLE_CLIENT_ID=

# Modo prueba (?prueba): cuenta y pedidos de prueba. Ponlo en "off" cuando
# publiques la tienda.
TEST_MODE=on

# Lista de agencias Shalom por departamento (opcional). Shalom no tiene API
# pública oficial; esta clave es de la API de terceros shalom-api-peru.com.
# Sin clave, la clienta escribe la agencia a mano.
SHALOM_API_KEY=

# Fotos en la nube (obligatorio al publicar en Render). En Cloudinary:
# Dashboard → "API Environment variable". Se ve así:
#   CLOUDINARY_URL=cloudinary://123456789012345:abcDEF...@tu-cloud-name
# Vacío = las fotos se guardan en server/uploads (solo para tu computadora).
CLOUDINARY_URL=

# Llave para firmar las sesiones de las clientas (texto largo al azar).
# En Render se genera sola.
SESSION_SECRET=

# Correos (bienvenida al club) con Brevo — gratis hasta 300 al día.
# Brevo → Configuración → SMTP y API → Claves API. MAIL_FROM es tu Gmail,
# verificado en Brevo como remitente.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Glow by Rosalía
PUBLIC_URL=https://glow-by-rosalia.onrender.com
